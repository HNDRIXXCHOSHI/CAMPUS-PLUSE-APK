<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Full canvas with space around the original logo. -->
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">

        <shape android:shape="rectangle">
            <solid android:color="#0B3263" />
        </shape>

    </item>

    <!-- Preserve the original artwork and keep it inside the safe area. -->
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="center"
        android:drawable="@drawable/campus_pulse_logo" />

</layer-list>